{
	"name": "intentsky-shopping",
	"version": "1.0.1",
	"private": true,
	"license": "MIT",
	"description": "Intentsky Shopping — a Medusa v2 commerce engine with quote requests (RFQ), Stripe, Resend email, S3/R2 media and a one-step connection to an Intentsky Project. Ready to deploy on Railway.",
	"homepage": "https://intentsky.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/intentsky/shopping"
	},
	"author": {
		"name": "Intentsky",
		"url": "https://intentsky.com"
	},
	"scripts": {
		"dev": "medusa develop",
		"build": "medusa build",
		"start": "medusa start",
		"migrate": "medusa db:migrate",
		"bootstrap": "medusa exec ./src/scripts/bootstrap.ts",
		"seed:example": "medusa exec ./src/scripts/seed-example-fasteners.ts",
		"user": "medusa user",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@medusajs/medusa": "2.20.1",
		"@medusajs/framework": "2.20.1",
		"@medusajs/dashboard": "2.20.1",
		"@medusajs/admin-bundler": "2.20.1",
		"@medusajs/admin-sdk": "2.20.1",
		"@medusajs/icons": "2.20.1",
		"@medusajs/js-sdk": "2.20.1",
		"@medusajs/ui": "4.2.3",
		"@medusajs/file-local": "2.20.1",
		"@medusajs/file-s3": "2.20.1",
		"@medusajs/payment-stripe": "2.20.1",
		"@medusajs/event-bus-redis": "2.20.1",
		"@medusajs/cache-redis": "2.20.1",
		"resend": "^4.0.0",
		"zod": "^3.23.8",
		"vite": "5.4.21",
		"@vitejs/plugin-react": "4.3.4",
		"@medusajs/cli": "2.20.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1"
	},
	"engines": {
		"node": ">=20"
	}
