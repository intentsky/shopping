# Intentsky Shopping — environment variables.
#
# Local:    cp .env.example .env   (never commit .env)
# Railway:  these are the service variables; the template generates the ones
#           marked (auto) and asks you for the rest at deploy.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=9000
# shared = API + background jobs in one process (default). server/worker to split.
MEDUSA_WORKER_MODE=shared
# true only on a dedicated worker instance.
MEDUSA_DISABLE_ADMIN=false

# ── Database / Redis ──────────────────────────────────────────────────────────
# Railway (auto): ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intentsky_shopping
# Optional. Railway (auto): ${{Redis.REDIS_URL}}?family=0  (IPv6 private network)
REDIS_URL=

# ── Secrets — generate with `openssl rand -hex 32` ────────────────────────────
# Railway (auto): ${{secret(64)}}
JWT_SECRET=change-me
COOKIE_SECRET=change-me
# Hashes visitor IPs for the inquiry rate limit (raw IPs are never stored).
IP_HASH_SALT=change-me

# ── URLs ──────────────────────────────────────────────────────────────────────
# Public URL of this engine. Railway (auto): https://${{RAILWAY_PUBLIC_DOMAIN}}
MEDUSA_BACKEND_URL=http://localhost:9000
# Your shop's website. Drives CORS defaults and the links in customer emails.
SHOPPING_STOREFRONT_URL=https://shop.example.com
# Explicit CORS lists (comma-separated) — only if the derived defaults are not enough.
# MEDUSA_STORE_CORS=
# MEDUSA_ADMIN_CORS=
# MEDUSA_AUTH_CORS=

# ── First admin user — created at boot when missing, by Medusa's own CLI ──────
# Change the password after the first login; you may then delete these two.
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=choose-a-long-password

# ── Intentsky Project connection ──────────────────────────────────────────────
# Both values come from the Intentsky console → Project → Shopping. The engine
# registers itself at boot; the console then shows the admin link and the
# storefront key, and can rotate that key. Leave empty to run unconnected.
INTENTSKY_PROJECT_ID=
INTENTSKY_CONNECT_TOKEN=
INTENTSKY_API_URL=https://api.intentsky.com

# ── Store identity (emails, admin copy) ───────────────────────────────────────
SHOPPING_BRAND_NAME=My Shop
SHOPPING_BRAND_SHORT=
# Per-language brand name, e.g. SHOPPING_BRAND_NAME_ZH=
SHOPPING_LEGAL_NAME=
SHOPPING_POSTAL_ADDRESS=
# Prefix of inquiry references: {PREFIX}-{unix_seconds}-{4_chars}
SHOPPING_REF_PREFIX=INQ
# First Region when the database is empty (carts/prices need one).
SHOPPING_CURRENCY=eur
SHOPPING_COUNTRIES=it,de,fr,es,nl,be,at,pt,ie
SHOPPING_REGION_NAME=
# 1 = seed the example catalogue (fasteners, quote-only) at the next start;
# idempotent. Remove the variable afterwards.
SHOPPING_SEED_EXAMPLE=

# ── Email (Resend) — optional; without it inquiries are saved, not mailed ─────
RESEND_API_KEY=
EMAIL_FROM=noreply@shop.example.com
# Receives a notification for every new inquiry.
OWNER_EMAIL=sales@example.com
# Digits only with country code, for the WhatsApp link in confirmation emails.
OWNER_WHATSAPP=

# ── Stripe — optional; without it the shop is quote-only (no checkout) ────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Media storage — optional S3-compatible (AWS S3, Cloudflare R2, MinIO) ─────
# Without these, uploads go to `static/` under the server directory: on
# Railway mount a Volume at /app/.medusa/server/static to keep them.
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
# Cloudflare R2 aliases also accepted: R2_ACCOUNT_ID, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_S3_URL, CDN_URL

# ── Admin dashboard build-time copy (optional) ────────────────────────────────
VITE_SHOPPING_BRAND_NAME=
VITE_SHOPPING_STOREFRONT_URL=
